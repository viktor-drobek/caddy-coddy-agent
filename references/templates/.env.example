# caddy-coddy environment — copy to .env on @@EDGE_NAME@@ (@@EDGE_DIR@@/.env) and fill in.
# docker compose interpolates ${VAR} from this file; Caddy reads it via env_file.
# Never commit .env. Generate secrets with:  openssl rand -hex 32

# --- Backends, as seen from Caddy (host network on @@EDGE_NAME@@) ---
# Coddy HTTP server on the @@CODDY_HOST_NAME@@ box.
CODDY_BACKEND=@@CODDY_BACKEND@@
# Keycloak and oauth2-proxy containers, published on loopback only.
KEYCLOAK_BACKEND=127.0.0.1:8080
OAUTH2_PROXY_BACKEND=127.0.0.1:4180

# --- Public addresses ---
PUBLIC_URL=@@PUBLIC_URL@@
PUBLIC_HOST=@@PUBLIC_HOST@@
# Keycloak public base URL; the OIDC issuer is ${KC_HOSTNAME}/realms/coddy.
KC_HOSTNAME=@@PUBLIC_URL@@/auth

# --- Coddy ---
# Coddy's own bearer token: httpserver.auth_token in @@CODDY_HOST_NAME@@:~/.coddy/config.yaml.
# Caddy sends it to Coddy on every authenticated request.
CODDY_API_TOKEN=

# --- Keycloak ---
KC_DB_PASSWORD=
# Master-realm admin (created on first start; console at ${KC_HOSTNAME}/admin/).
KC_ADMIN_USER=admin
KC_ADMIN_PASSWORD=
# OIDC client "coddy-web" (used by oauth2-proxy for browser logins).
CODDY_WEB_CLIENT_SECRET=
# OIDC client "coddy-service" (example machine client, client_credentials grant).
CODDY_SERVICE_CLIENT_SECRET=
# First user in realm "coddy", created by keycloak/bootstrap.sh with a temporary
# password (must be changed at first login). Leave KC_INITIAL_USER empty to skip.
KC_INITIAL_USER=@@INITIAL_USER@@
KC_INITIAL_USER_PASSWORD=
KC_INITIAL_USER_EMAIL=

# --- oauth2-proxy ---
# 32 random bytes, base64url:  openssl rand -base64 32 | tr -- '+/' '-_'
OAUTH2_PROXY_COOKIE_SECRET=
