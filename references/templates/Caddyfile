# Caddy edge for Coddy at @@PUBLIC_URL@@ — Keycloak IAM + oauth2-proxy.
#
# Runs on @@EDGE_NAME@@ (@@EDGE_HOST@@, host network). Coddy runs on @@CODDY_HOST_NAME@@
# (@@CODDY_BACKEND@@). Keycloak and oauth2-proxy run next to Caddy on
# @@EDGE_NAME@@ and are only reachable through it (loopback ports).
#
#   /auth/*    -> Keycloak        (login pages, OIDC endpoints; admin console
#                                  and master realm only behind a Coddy login)
#   /oauth2/*  -> oauth2-proxy    (OIDC client: /oauth2/start, /oauth2/callback,
#                                  /oauth2/sign_out, /oauth2/auth)
#   /tg/*      -> tg-auth         (Telegram Mini App: landing page, initData login;
#                                  /tg/auth/verify checks the _coddy_tg cookie)
#   /*         -> forward_auth oauth2-proxy, then reverse_proxy Coddy with the
#                 Authorization header replaced by Coddy's own API token.
#
# Two ways in:
#   1. Browser: page load without a session cookie -> 302 /oauth2/start ->
#      Keycloak username / password form -> /oauth2/callback -> oauth2-proxy
#      session cookie -> Coddy web UI. Non-page requests (XHR/SSE) get 401. Coddy sees "Authorization: Bearer <CODDY_API_TOKEN>", so
#      its own sign-in screen is skipped (/coddy/auth/me reports authenticated).
#   2. Service / CLI: "Authorization: Bearer <Keycloak access token>", obtained
#      from Keycloak with OAuth2 (client_credentials for services, password
#      grant on the public client coddy-cli for people). oauth2-proxy verifies the
#      JWT (issuer, signature, audience "coddy-web"); Caddy then swaps the
#      header for CODDY_API_TOKEN. Clients never learn Coddy's token and Coddy
#      never sees Keycloak tokens.
#   3. Telegram Mini App: the app opens /tg/, tg-auth verifies Telegram's signed
#      initData with the bot token, admits only TG_ALLOWED_USER_IDS and sets the
#      _coddy_tg cookie; from then on requests are checked at tg-auth instead of
#      oauth2-proxy and reach Coddy with the same CODDY_API_TOKEN swap.
#
# All addresses and secrets come from .env (see .env.example).

# Expanded forward_auth: successful auth must also return refreshed cookies to
# the browser. copy_response_headers preserves every Set-Cookie value, including
# split session cookies; copy_headers alone would copy them into the request.
(oauth2_auth) {
	method GET
	rewrite /oauth2/auth
	header_up X-Forwarded-Method {method}
	header_up X-Forwarded-Uri {uri}
	@authenticated status 2xx
	handle_response @authenticated {
		@auth_user not vars {rp.header.X-Auth-Request-User} ""
		@auth_username not vars {rp.header.X-Auth-Request-Preferred-Username} ""
		@auth_email not vars {rp.header.X-Auth-Request-Email} ""
		route {
			# Never retain caller-supplied identity headers when the auth response
			# omits an optional claim (for example a service account's email).
			request_header -X-Auth-Request-*
			request_header @auth_user X-Auth-Request-User {rp.header.X-Auth-Request-User}
			request_header @auth_username X-Auth-Request-Preferred-Username {rp.header.X-Auth-Request-Preferred-Username}
			request_header @auth_email X-Auth-Request-Email {rp.header.X-Auth-Request-Email}
			copy_response_headers {
				include Set-Cookie
			}
		}
	}
}

# Telegram Mini App sessions: tg-auth verified the Telegram initData once and
# issued the _coddy_tg cookie; every request carrying it is checked here the way
# Keycloak sessions are checked at oauth2-proxy. Identity headers come only from
# the verify response, never from the caller.
(tg_auth) {
	method GET
	rewrite /tg/auth/verify
	header_up X-Forwarded-Method {method}
	header_up X-Forwarded-Uri {uri}
	@tg_ok status 2xx
	handle_response @tg_ok {
		route {
			request_header -X-Auth-Request-*
			request_header X-Auth-Request-User {rp.header.X-Auth-Request-User}
			request_header X-Auth-Request-Preferred-Username {rp.header.X-Auth-Request-Preferred-Username}
		}
	}
}

# Swarm URLs are handled before the general Telegram and Keycloak routes below,
# so select the matching browser-session verifier here. A Telegram cookie takes
# precedence and fails closed when it is stale; all other callers use Keycloak.
(swarm_browser_auth) {
	reverse_proxy @tg_session {env.TG_AUTH_BACKEND} {
		import tg_auth
		header_up -Authorization
	}
	reverse_proxy @non_tg_session {env.OAUTH2_PROXY_BACKEND} {
		import oauth2_auth
		header_up -Authorization
	}
}

(coddy_upstream) {
	reverse_proxy {env.CODDY_BACKEND} {
		# Coddy's static API token (httpserver.auth_token in @@CODDY_HOST_NAME@@:~/.coddy/config.yaml).
		header_up Authorization "Bearer {env.CODDY_API_TOKEN}"
		# Who is calling, as seen by Keycloak (from oauth2-proxy's X-Auth-Request-*).
		header_up X-Forwarded-User {http.request.header.X-Auth-Request-Preferred-Username}
		# Coddy streams (SSE on /coddy/events and composer-stream): never buffer.
		flush_interval -1
		transport http {
			read_timeout 0
			write_timeout 0
		}
	}
}

@@PUBLIC_URL@@ {
	# --- Keycloak (KC_HTTP_RELATIVE_PATH=/auth, KC_PROXY_HEADERS=xforwarded) ---
	handle /auth/* {
		# Admin console, admin REST API and the master realm are not exposed
		# anonymously: the browser must already hold a Coddy (realm "coddy")
		# session cookie. Keycloak's own admin credentials still apply on top.
		@kc_admin path /auth/admin/* /auth/realms/master/*
		handle @kc_admin {
			route {
				reverse_proxy {env.OAUTH2_PROXY_BACKEND} {
					import oauth2_auth
					# Check only the cookie; preserve the master-realm bearer token
					# on the original request forwarded to Keycloak afterwards.
					header_up -Authorization

					@unauthenticated status 401
					handle_response @unauthenticated {
						copy_response_headers {
							include Set-Cookie
						}
						redir * /oauth2/start?rd={scheme}://{host}{uri} 302
					}
				}
				reverse_proxy {env.KEYCLOAK_BACKEND}
			}
		}

		# Realm "coddy": login pages, OIDC endpoints, account console, theme assets.
		handle {
			reverse_proxy {env.KEYCLOAK_BACKEND}
		}
	}

	# --- oauth2-proxy's own endpoints ---
	handle /oauth2/* {
		reverse_proxy {env.OAUTH2_PROXY_BACKEND}
	}

	# --- Coddy swarm relay: authenticate the browser session through oauth2-proxy,
	# or tg-auth, then replace the caller's Authorization header with the relay
	# client token. ---
	# The remote environment also requests the relay host's own Coddy API. Keep
	# those requests on CODDY_BACKEND; only /swarm/* belongs to the relay port.
	@tg_session header Cookie *_coddy_tg=*
	@non_tg_session not header Cookie *_coddy_tg=*
	handle /swarm-relay/coddy/* {
		route {
			import swarm_browser_auth
			uri strip_prefix /swarm-relay
			import coddy_upstream
		}
	}
	handle /swarm-relay/v1/* {
		route {
			import swarm_browser_auth
			uri strip_prefix /swarm-relay
			import coddy_upstream
		}
	}
	handle /swarm-relay/* {
		route {
			import swarm_browser_auth
			uri strip_prefix /swarm-relay
			reverse_proxy {env.SWARM_RELAY_BACKEND} {
				header_up Authorization "Bearer {env.CODDY_SWARM_TOKEN}"
				header_up X-Forwarded-User {http.request.header.X-Auth-Request-Preferred-Username}
				flush_interval -1
				transport http {
					read_timeout 0
					write_timeout 0
				}
			}
		}
	}

	# The UI uses absolute /swarm/* paths after it recognises a relay and while
	# navigating node mounts, even when the configured remote has a path prefix.
	handle /swarm/* {
		route {
			import swarm_browser_auth
			reverse_proxy {env.SWARM_RELAY_BACKEND} {
				header_up Authorization "Bearer {env.CODDY_SWARM_TOKEN}"
				header_up X-Forwarded-User {http.request.header.X-Auth-Request-Preferred-Username}
				flush_interval -1
				transport http {
					read_timeout 0
					write_timeout 0
				}
			}
		}
	}

	# --- Telegram Mini App: the landing page (reads initData inside Telegram and
	# posts it to /tg/auth/login) and the login endpoint are public; the verify
	# endpoint is for this Caddyfile only. Empty TG_BOT_TOKEN turns all of it off
	# inside tg-auth (404 / 503). ---
	handle /tg/auth/verify {
		respond 404
	}
	handle /tg/* {
		reverse_proxy {env.TG_AUTH_BACKEND}
	}

	# --- Telegram sessions (_coddy_tg cookie) replace the Keycloak session and take
	# precedence over it. A stale cookie sends a page load back to /tg/, where the
	# Mini App signs in again; XHR/SSE get 401. ---
	@tg_page {
		header Cookie *_coddy_tg=*
		header Accept *text/html*
	}
	handle @tg_page {
		route {
			reverse_proxy {env.TG_AUTH_BACKEND} {
				import tg_auth
				@tg_unauthenticated status 401
				handle_response @tg_unauthenticated {
					redir * /tg/?rd={uri} 302
				}
			}
			import coddy_upstream
		}
	}
	@tg header Cookie *_coddy_tg=*
	handle @tg {
		route {
			reverse_proxy {env.TG_AUTH_BACKEND} {
				import tg_auth
			}
			import coddy_upstream
		}
	}

	# --- Services: Keycloak bearer token. Invalid/expired -> 401 from oauth2-proxy. ---
	@bearer header Authorization Bearer*
	handle @bearer {
		route {
			reverse_proxy {env.OAUTH2_PROXY_BACKEND} {
				import oauth2_auth
			}
			import coddy_upstream
		}
	}

	# --- Browser page loads (Accept: text/html): session cookie, otherwise go
	# log in at Keycloak. Only navigations are redirected: if the UI's parallel
	# XHR/SSE calls were redirected too, each /oauth2/start would overwrite the
	# login state cookie and the callback would fail with a PKCE mismatch. ---
	@page header Accept *text/html*
	handle @page {
		route {
			reverse_proxy {env.OAUTH2_PROXY_BACKEND} {
				import oauth2_auth

				@unauthenticated status 401
				handle_response @unauthenticated {
					copy_response_headers {
						include Set-Cookie
					}
					redir * /oauth2/start?rd={scheme}://{host}{uri} 302
				}
			}
			import coddy_upstream
		}
	}

	# --- Everything else from a browser (fetch/XHR/EventSource): cookie or 401. ---
	handle {
		route {
			reverse_proxy {env.OAUTH2_PROXY_BACKEND} {
				import oauth2_auth
			}
			import coddy_upstream
		}
	}

	# Security headers.
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	# Access log to stdout.
	log {
		output stdout
		format json
	}
}
